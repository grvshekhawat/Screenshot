# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (leave empty to use local demo mode)
NEXT_PUBLIC_SUPABASE_URL=
# New dashboard key: Settings → API Keys → Publishable (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT still works if you set this instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Billing function base, e.g. https://xxxx.supabase.co/functions/v1
NEXT_PUBLIC_BILLING_FUNCTIONS_URL=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICE_ID=
# Server secrets (Edge Functions): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_PLAN_ID=
# Server secrets: PAYPAL_CLIENT_SECRET, PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Edge Function secrets (set via `supabase secrets set`, not NEXT_PUBLIC):
# OPENAI_API_KEY=sk-...   # Edge secret: generate-clipart + analyze-store-layout
